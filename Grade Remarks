import java.util.Scanner;

public class Main{
    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);
        String name;
        int score1;
        int score2;
        int score3;

        System.out.println("What is your name:  ");
        name = scanner.nextLine();
        System.out.println("What is your score in Exam 1: ");
        score1 = scanner.nextInt();
        System.out.println("What is your score in Exam 2: ");
        score2 = scanner.nextInt();
        System.out.println("What is your score in Exam 3: ");
        score3 = scanner.nextInt();

        int scores = score1 + score2 + score3;
        double total = scores / 3.0;

        System.out.println("Hello! " + name);
        System.out.println("Exam 1: " + score1);
        System.out.println("Exam 2: " + score2);
        System.out.println("Exam 3: " + score3);

        System.out.println("Avarage: " + total);

        if (total >= 90){
            System.out.println("Result: Excellent");
        }
        else if (total >= 80){
            System.out.println("Result: Very Good!");
        }
        else if (total >= 75){
            System.out.println("Result: Passed");
        }
        else{
            System.out.println("Failed");
        }

    }
}
